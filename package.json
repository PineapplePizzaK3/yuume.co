{
  "name": "delivery-site-institucional",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build && wrangler dev",
    "supabase:functions:deploy:catalog-search": "supabase functions deploy catalog-search",
    "scrape:quality": "node scripts/scrape-quality-report.mjs",
    "catalog:on-demand:refresh": "node scripts/on-demand/update-snkrdunk-catalog.mjs",
    "catalog:live-rips:box-pack": "node scripts/live-rips/build-box-pack-catalog.mjs",
    "catalog:collection-top-cards": "node scripts/on-demand/build-collection-top-cards.mjs",
    "catalog:live-rips:refresh": "npm run catalog:on-demand:refresh && npm run catalog:live-rips:box-pack",
    "catalog:sets:import": "node --env-file=.env scripts/catalog/import-tcgdex-set.mjs",
    "catalog:sets:validate": "node --env-file=.env scripts/catalog/validate-set.mjs",
    "catalog:market:snapshots": "node --env-file=.env scripts/catalog/refresh-market-snapshots.mjs",
    "catalog:cleanup-listing-index": "node --env-file=.env scripts/catalog/cleanup-listing-index.mjs",
    "catalog:refresh-hot-queries": "node --env-file=.env scripts/catalog/refresh-hot-queries.mjs",
    "catalog:box-break:seed": "node scripts/catalog/seed-live-box-breaks.mjs",
    "recalc:calculator-margin": "node --import ./scripts/register-extensionless.mjs scripts/recalc-calculator-products-margin.mjs",
    "recalc:calculator-margin:dry": "node --import ./scripts/register-extensionless.mjs scripts/recalc-calculator-products-margin.mjs --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "buffer": "^6.0.3",
    "i18next": "^26.0.3",
    "pdfkit": "^0.15.0",
    "qrcode-pix": "5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^6.26.2",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.35.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "supabase": "2.89.0",
    "tailwindcss": "^3.4.14",
    "vercel": "^39.4.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.87.0"
  }
}
